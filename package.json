{
  "name": "tiller",
  "version": "0.5.0",
  "description": "File-based AI software engineering workflow and project initialization",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tiller": "dist/cli.js"
  },
  "files": [
    "dist/",
    "resources/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test-suites.mjs all",
    "test:rules": "node scripts/test-suites.mjs rules",
    "test:contracts": "node scripts/test-suites.mjs contracts",
    "test:integration": "node scripts/test-suites.mjs integration",
    "test:e2e": "node scripts/test-suites.mjs e2e",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
