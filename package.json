{
  "name": "tiller",
  "version": "0.3.4",
  "description": "File-based AI software engineering workflow and project initialization",
  "type": "module",
  "bin": {
    "tiller": "dist/cli.js"
  },
  "files": [
    "dist/",
    "resources/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
