{
  "schemaVersion": 1,
  "id": "validation",
  "version": "1.0.0",
  "title": "实现核查与验收验证",
  "appliesTo": [
    "依据已确认标准验证实际实现，提供技术结论。"
  ],
  "notApplicableTo": [
    "受委托验证不能冒充用户验收；副作用测试单独核对操作授权。"
  ],
  "stages": [
    {
      "id": "basis",
      "title": "验收依据与验证选择",
      "dependsOn": [],
      "consumes": [],
      "produces": [
        "basis-output"
      ],
      "checks": [
        "核对有效验收依据、实际对象版本、类别、覆盖和环境。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    },
    {
      "id": "test-authorization",
      "title": "副作用测试授权",
      "dependsOn": [
        "basis"
      ],
      "consumes": [
        "basis-output"
      ],
      "produces": [
        "test-authorization-output"
      ],
      "checks": [
        "对数据、环境、凭据和外部服务影响绑定具体操作与恢复条件。"
      ],
      "confirmations": [
        "operation"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "when": {
        "any": [
          {
            "fact": "experimentSideEffects",
            "equals": true
          },
          {
            "fact": "production",
            "equals": true
          },
          {
            "fact": "writesData",
            "equals": true
          },
          {
            "fact": "credentials",
            "equals": true
          },
          {
            "fact": "irreversible",
            "equals": true
          },
          {
            "fact": "externalService",
            "equals": true
          }
        ]
      },
      "confirmationAt": "start"
    },
    {
      "id": "results",
      "title": "实际验证结果",
      "dependsOn": [
        "basis",
        "test-authorization"
      ],
      "consumes": [
        "basis-output"
      ],
      "produces": [
        "results-output"
      ],
      "checks": [
        "实际执行选择并保存结果，未执行或失败不得登记为通过。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "test",
        "write-report"
      ]
    },
    {
      "id": "report",
      "title": "覆盖与技术结论",
      "dependsOn": [
        "results"
      ],
      "consumes": [
        "results-output"
      ],
      "produces": [
        "report-output"
      ],
      "checks": [
        "技术结论、未覆盖范围及真实用户接受分别记录。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    }
  ],
  "outputs": [
    {
      "id": "basis-output",
      "role": "basis",
      "title": "验收依据与验证选择",
      "producer": "basis"
    },
    {
      "id": "test-authorization-output",
      "role": "test-authorization",
      "title": "副作用测试授权",
      "producer": "test-authorization"
    },
    {
      "id": "results-output",
      "role": "results",
      "title": "实际验证结果",
      "producer": "results"
    },
    {
      "id": "report-output",
      "role": "verification",
      "title": "覆盖与技术结论",
      "producer": "report"
    }
  ],
  "completion": {
    "requiredStages": [
      "report"
    ],
    "requiredOutputs": [
      "basis-output",
      "test-authorization-output",
      "results-output",
      "report-output"
    ],
    "checks": [
      "产物与实际证据一致；未知影响和未覆盖范围如实记录；交付不自动表示用户接受或操作授权。"
    ],
    "result": "report-delivered"
  }
}
