{
  "schemaVersion": 1,
  "id": "analysis",
  "version": "1.0.0",
  "title": "问题分析",
  "appliesTo": [
    "依据明确请求进行只读问题调查，提供有证据的结论。"
  ],
  "notApplicableTo": [
    "修复、代码变更、合入和发布需另行选择相应工作与授权。"
  ],
  "stages": [
    {
      "id": "scope",
      "title": "现象与范围",
      "dependsOn": [],
      "consumes": [],
      "produces": [
        "scope-output"
      ],
      "checks": [
        "记录实际现象、授权的调查边界和成功标准。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    },
    {
      "id": "evidence",
      "title": "证据收集",
      "dependsOn": [
        "scope"
      ],
      "consumes": [
        "scope-output"
      ],
      "produces": [
        "evidence-output"
      ],
      "checks": [
        "只读取得可定位的事实，区分事实与推测。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    },
    {
      "id": "hypotheses",
      "title": "假设验证",
      "dependsOn": [
        "evidence"
      ],
      "consumes": [
        "evidence-output"
      ],
      "produces": [
        "hypotheses-output"
      ],
      "checks": [
        "对照证据验证候选原因，保留不能排除的解释。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    },
    {
      "id": "report",
      "title": "结论报告",
      "dependsOn": [
        "hypotheses"
      ],
      "consumes": [
        "hypotheses-output"
      ],
      "produces": [
        "report-output"
      ],
      "checks": [
        "报告原因、证据、不确定性及建议，不自动实施修复。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    }
  ],
  "outputs": [
    {
      "id": "scope-output",
      "role": "scope",
      "title": "现象与范围",
      "producer": "scope"
    },
    {
      "id": "evidence-output",
      "role": "evidence",
      "title": "证据收集",
      "producer": "evidence"
    },
    {
      "id": "hypotheses-output",
      "role": "hypotheses",
      "title": "假设验证",
      "producer": "hypotheses"
    },
    {
      "id": "report-output",
      "role": "analysis",
      "title": "结论报告",
      "producer": "report"
    }
  ],
  "completion": {
    "requiredStages": [
      "report"
    ],
    "requiredOutputs": [
      "scope-output",
      "evidence-output",
      "hypotheses-output",
      "report-output"
    ],
    "checks": [
      "产物与实际证据一致；未知影响和未覆盖范围如实记录；交付不自动表示用户接受或操作授权。"
    ],
    "result": "report-delivered"
  }
}
