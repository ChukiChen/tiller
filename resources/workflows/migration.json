{
  "schemaVersion": 1,
  "id": "migration",
  "version": "1.0.0",
  "title": "升级与迁移",
  "appliesTo": [
    "将明确对象从当前状态迁移到目标状态。"
  ],
  "notApplicableTo": [
    "失败不能自动触发未授权回滚；代码变更仍须遵守开发任务约束。"
  ],
  "stages": [
    {
      "id": "current",
      "title": "现状调查",
      "dependsOn": [],
      "consumes": [],
      "produces": [
        "current-output"
      ],
      "checks": [
        "记录对象版本、环境、数据和兼容现状。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report"
      ]
    },
    {
      "id": "requirements",
      "title": "迁移目标确认",
      "dependsOn": [
        "current"
      ],
      "consumes": [
        "current-output"
      ],
      "produces": [
        "requirements-output"
      ],
      "checks": [
        "确认目标状态、兼容边界和成功条件。"
      ],
      "confirmations": [
        "requirements"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "confirmationAt": "verify"
    },
    {
      "id": "design",
      "title": "迁移与恢复方案确认",
      "dependsOn": [
        "requirements"
      ],
      "consumes": [
        "requirements-output"
      ],
      "produces": [
        "design-output"
      ],
      "checks": [
        "明确操作方案、恢复条件、备份和失败状态报告方式。"
      ],
      "confirmations": [
        "design"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "confirmationAt": "verify"
    },
    {
      "id": "planning",
      "title": "执行安排确认",
      "dependsOn": [
        "design"
      ],
      "consumes": [
        "design-output"
      ],
      "produces": [
        "planning-output"
      ],
      "checks": [
        "确认步骤、依赖、观察窗口和必要验证。"
      ],
      "confirmations": [
        "planning"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "confirmationAt": "verify"
    },
    {
      "id": "operation",
      "title": "具体迁移操作",
      "dependsOn": [
        "planning"
      ],
      "consumes": [
        "planning-output"
      ],
      "produces": [
        "operation-output"
      ],
      "checks": [
        "操作授权绑定实际环境、数据、对象和恢复条件；不擅自执行回滚。"
      ],
      "confirmations": [
        "operation"
      ],
      "actions": [
        "configure-environment",
        "write-data",
        "operate",
        "write-report"
      ],
      "confirmationAt": "start"
    },
    {
      "id": "verification",
      "title": "迁移核验",
      "dependsOn": [
        "operation"
      ],
      "consumes": [
        "operation-output"
      ],
      "produces": [
        "verification-output"
      ],
      "checks": [
        "检查目标状态、兼容性和数据完整性；失败保持真实状态并报告。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "test",
        "write-report"
      ]
    }
  ],
  "outputs": [
    {
      "id": "current-output",
      "role": "current",
      "title": "现状调查",
      "producer": "current"
    },
    {
      "id": "requirements-output",
      "role": "requirements",
      "title": "迁移目标确认",
      "producer": "requirements"
    },
    {
      "id": "design-output",
      "role": "design",
      "title": "迁移与恢复方案确认",
      "producer": "design"
    },
    {
      "id": "planning-output",
      "role": "planning",
      "title": "执行安排确认",
      "producer": "planning"
    },
    {
      "id": "operation-output",
      "role": "operation",
      "title": "具体迁移操作",
      "producer": "operation"
    },
    {
      "id": "verification-output",
      "role": "verification",
      "title": "迁移核验",
      "producer": "verification"
    }
  ],
  "completion": {
    "requiredStages": [
      "verification"
    ],
    "requiredOutputs": [
      "current-output",
      "requirements-output",
      "design-output",
      "planning-output",
      "operation-output",
      "verification-output"
    ],
    "checks": [
      "产物与实际证据一致；未知影响和未覆盖范围如实记录；交付不自动表示用户接受或操作授权。"
    ],
    "result": "change-verified"
  }
}
