{
  "schemaVersion": 1,
  "id": "bugfix",
  "version": "1.0.0",
  "title": "缺陷修复",
  "appliesTo": [
    "复现并修复具体缺陷。"
  ],
  "notApplicableTo": [
    "独立修复不自动减免需求、设计、规划或操作确认。"
  ],
  "stages": [
    {
      "id": "reproduce",
      "title": "缺陷复现",
      "dependsOn": [],
      "consumes": [],
      "produces": [
        "reproduce-output"
      ],
      "checks": [
        "记录预期与实际、环境和最小复现证据。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report",
        "test"
      ]
    },
    {
      "id": "cause",
      "title": "原因与修复范围",
      "dependsOn": [
        "reproduce"
      ],
      "consumes": [
        "reproduce-output"
      ],
      "produces": [
        "cause-output"
      ],
      "checks": [
        "先调查原因；分析授权不等于写代码许可。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "write-report",
        "test"
      ]
    },
    {
      "id": "requirements",
      "title": "目标与需求确认",
      "dependsOn": [
        "cause"
      ],
      "consumes": [
        "cause-output"
      ],
      "produces": [
        "requirements-output"
      ],
      "checks": [
        "确认实际变更目标、边界、验收条件及有效来源。"
      ],
      "confirmations": [
        "requirements"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "confirmationAt": "verify"
    },
    {
      "id": "design",
      "title": "方案设计确认",
      "dependsOn": [
        "requirements"
      ],
      "consumes": [
        "requirements-output"
      ],
      "produces": [
        "design-output"
      ],
      "checks": [
        "展示设计与需求对应、取舍、风险和验证方式。"
      ],
      "confirmations": [
        "design"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "confirmationAt": "verify"
    },
    {
      "id": "planning",
      "title": "实施规划确认",
      "dependsOn": [
        "design"
      ],
      "consumes": [
        "design-output"
      ],
      "produces": [
        "planning-output"
      ],
      "checks": [
        "登记任务边界、依赖、需求覆盖和验证条件并确认；单任务仍需规划。"
      ],
      "confirmations": [
        "planning"
      ],
      "actions": [
        "read",
        "write-report"
      ],
      "confirmationAt": "verify"
    },
    {
      "id": "implementation",
      "title": "实现",
      "dependsOn": [
        "planning"
      ],
      "consumes": [
        "planning-output"
      ],
      "produces": [
        "implementation-output"
      ],
      "checks": [
        "使用已存在的 task start/verify/resume 推进开发任务；阶段声明不替代任务证据。"
      ],
      "confirmations": [],
      "actions": [
        "edit-code",
        "test",
        "write-report"
      ]
    },
    {
      "id": "verification",
      "title": "实际验证",
      "dependsOn": [
        "implementation"
      ],
      "consumes": [
        "implementation-output"
      ],
      "produces": [
        "verification-output"
      ],
      "checks": [
        "依据目标运行适用检查；失败和未覆盖项分别报告；交付与用户验收分开。",
        "回归覆盖原缺陷和受影响既有行为。"
      ],
      "confirmations": [],
      "actions": [
        "read",
        "test",
        "write-report"
      ]
    }
  ],
  "outputs": [
    {
      "id": "reproduce-output",
      "role": "reproduce",
      "title": "缺陷复现",
      "producer": "reproduce"
    },
    {
      "id": "cause-output",
      "role": "cause",
      "title": "原因与修复范围",
      "producer": "cause"
    },
    {
      "id": "requirements-output",
      "role": "requirements",
      "title": "目标与需求确认",
      "producer": "requirements"
    },
    {
      "id": "design-output",
      "role": "design",
      "title": "方案设计确认",
      "producer": "design"
    },
    {
      "id": "planning-output",
      "role": "planning",
      "title": "实施规划确认",
      "producer": "planning"
    },
    {
      "id": "implementation-output",
      "role": "code",
      "title": "实现",
      "producer": "implementation"
    },
    {
      "id": "verification-output",
      "role": "verification",
      "title": "实际验证",
      "producer": "verification"
    }
  ],
  "completion": {
    "requiredStages": [
      "verification"
    ],
    "requiredOutputs": [
      "reproduce-output",
      "cause-output",
      "requirements-output",
      "design-output",
      "planning-output",
      "implementation-output",
      "verification-output"
    ],
    "checks": [
      "产物与实际证据一致；未知影响和未覆盖范围如实记录；交付不自动表示用户接受或操作授权。"
    ],
    "result": "change-verified"
  }
}
